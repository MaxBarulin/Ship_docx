# Задание и план команды — чужие файлы, их нельзя менять даже переводом строк.
# -text отключает нормализацию CRLF/LF: в репозиторий и обратно они ходят байт в байт.
docs/задание/** -text
docs/план/**    -text

# Бинарные выгрузки модели: без diff и без нормализации
*.blend  binary
*.glb    binary
*.docx   binary
*.xlsx   binary
